# Supported environments: development, test, staging, production.
# Interactive API documentation is enabled only in development.
APP_ENV=development
APP_VERSION=0.1.0

# Optional: leave blank until the Supabase integration is implemented.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend only. Never ship this key to the mobile client.
SUPABASE_SECRET_KEY=
# Public endpoint configuration; JWT/JWKS verification is not implemented yet.
SUPABASE_JWKS_URL=

# Legacy keys remain supported independently; no automatic key fallback is applied.
SUPABASE_ANON_KEY=
# Backend only. Never ship this key to the mobile client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, backend only. AI integration is not implemented yet.
LLM_API_KEY=
