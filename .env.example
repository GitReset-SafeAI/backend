# Supported environments: development, test, staging, production.
# Interactive API documentation is enabled only in development.
APP_ENV=development
APP_VERSION=0.1.0

# Optional: leave blank until the Supabase integration is implemented.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend only. Never ship this key to the mobile client.
SUPABASE_SECRET_KEY=
# Public endpoint configuration; JWT/JWKS verification is not implemented yet.
SUPABASE_JWKS_URL=

# Legacy keys remain supported independently; no automatic key fallback is applied.
SUPABASE_ANON_KEY=
# Backend only. Never ship this key to the mobile client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, backend only. AI integration is not implemented yet.
LLM_API_KEY=

# Backend-only Groq credential, shared by text translation and draft transcription.
# LLM_API_KEY is not an automatic fallback for GROQ_API_KEY.
GROQ_API_KEY=

# Optional transcription overrides. Leave commented to use defaults:
# model whisper-large-v3, timeout 30 seconds, size 10485760 bytes, duration 60 seconds.
# Size and duration overrides may tighten the approved ceilings, not increase them.
# TRANSCRIPTION_MODEL=
# TRANSCRIPTION_TIMEOUT_SECONDS=
# Optional probe + conversion deadline, default 15 seconds (maximum 30).
# TRANSCRIPTION_CONVERSION_TIMEOUT_SECONDS=
# TRANSCRIPTION_MAX_BYTES=
# TRANSCRIPTION_MAX_DURATION_SECONDS=
# Groq requests reuse LLM_BASE_URL (default: https://api.groq.com/openai/v1).
