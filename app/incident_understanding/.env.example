# Copy these settings into the backend root .env.
# Configuration only; keep disabled until the integration is implemented.
INCIDENT_UNDERSTANDING_ENABLED=false
# Backend only. Supply your LLM provider API key when enabling the module.
INCIDENT_UNDERSTANDING_API_KEY=sk-proj-REPLACE_ME
INCIDENT_UNDERSTANDING_MODEL=gpt-4.1-mini
INCIDENT_UNDERSTANDING_TIMEOUT_SECONDS=60
INCIDENT_UNDERSTANDING_MAX_RETRIES=2
INCIDENT_UNDERSTANDING_MAX_REPORT_CHARACTERS=10000
INCIDENT_UNDERSTANDING_MAX_OUTPUT_TOKENS=1500
# Reports below this confidence should use the unclear-report fallback.
INCIDENT_UNDERSTANDING_CONFIDENCE_THRESHOLD=0.65
